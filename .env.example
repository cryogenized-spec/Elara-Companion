# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.7-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for Google Workspace integrations
VITE_GOOGLE_CLIENT_ID=""

# Production Express backend trust boundary.
# Set only when a production backend is intentionally exposed to a trusted caller.
# The client must send: Authorization: Bearer <ELARA_SERVER_ACCESS_TOKEN>
ELARA_SERVER_ACCESS_TOKEN=""
# Comma-separated exact browser origins allowed to call the backend in production.
ELARA_ALLOWED_ORIGINS="https://your-app.example"

# Automation dispatcher (local development only).
# In GitHub Actions, configure these through repository Variables/Secrets instead.
# ELARA_STATE_REPO must point to a separate PRIVATE GitHub repository containing
# automations.json and runtime.json, for example cryogenized-spec/Elara-private-state.
ELARA_STATE_REPO=""
ELARA_STATE_TOKEN=""
