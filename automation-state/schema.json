{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elara Automation State",
  "type": "object",
  "properties": {
    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "prompt", "enabled", "frequency", "date", "time", "timezone", "retryAttempts", "retryDelaySeconds", "nextRunAt"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "prompt": {"type": "string"},
          "enabled": {"type": "boolean"},
          "frequency": {"enum": ["once", "daily", "weekly", "monthly"]},
          "date": {"type": "string"},
          "time": {"type": "string"},
          "timezone": {"type": "string"},
          "retryAttempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "retryDelaySeconds": {"type": "integer", "minimum": 5, "maximum": 60},
          "nextRunAt": {"type": ["string", "null"]}
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["version", "jobs", "schedules"],
      "properties": {
        "version": {"const": 1},
        "jobs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["automationId", "scheduledFor", "status"],
            "properties": {
              "automationId": {"type": "string"},
              "scheduledFor": {"type": "string"},
              "executionKey": {"type": "string"},
              "status": {"enum": ["dispatching", "dispatched", "awaiting_agent_runtime", "running", "success", "succeeded", "failed", "dispatch_failed"]},
              "attempts": {"type": "integer", "minimum": 0},
              "lastAttemptAt": {"type": "string"},
              "updatedAt": {"type": "string"},
              "claimRunId": {"type": ["string", "null"]},
              "workerRunId": {"type": ["string", "null"]},
              "workerUrl": {"type": ["string", "null"]},
              "startedAt": {"type": "string"},
              "completedAt": {"type": "string"},
              "error": {"type": "string"}
            }
          }
        },
        "schedules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["nextRunAt"],
            "properties": {
              "nextRunAt": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
