{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elara-background-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "GOOGLE_VAULT_KV",
      "id": "REPLACE_WITH_GOOGLE_VAULT_KV_NAMESPACE_ID"
    }
  ],
  "workflows": [
    {
      "name": "elara-chat-workflow",
      "binding": "ELARA_CHAT_WORKFLOW",
      "class_name": "ElaraChatWorkflow"
    }
  ]
}
