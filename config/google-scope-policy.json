{
  "version": 1,
  "strategy": "incremental_capability_authorization",
  "initialAuthorization": {"scopes": ["openid", "email", "profile"], "purpose": "Establish Google identity/connection without requesting Workspace data permissions."},
  "capabilities": {
    "gmail.read": {"scopes": ["https://www.googleapis.com/auth/gmail.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Gmail listing", "Gmail message detail"]},
    "gmail.compose": {"scopes": ["https://www.googleapis.com/auth/gmail.compose"], "risk": "sensitive", "default": false, "usedBy": ["Create Gmail draft"]},
    "gmail.send": {"scopes": ["https://www.googleapis.com/auth/gmail.send"], "risk": "sensitive", "default": false, "usedBy": ["Send Gmail message"]},
    "gmail.modify": {"scopes": ["https://www.googleapis.com/auth/gmail.modify"], "risk": "sensitive", "default": false, "usedBy": ["Mailbox mutation/label operations when required"]},
    "calendar.read": {"scopes": ["https://www.googleapis.com/auth/calendar.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Calendar event read operations"]},
    "calendar.write": {"scopes": ["https://www.googleapis.com/auth/calendar.events"], "risk": "sensitive", "default": false, "usedBy": ["Calendar event creation/editing"]},
    "calendar.list": {"scopes": ["https://www.googleapis.com/auth/calendar.calendarlist.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Subscribed calendar discovery"]},
    "calendar.freebusy": {"scopes": ["https://www.googleapis.com/auth/calendar.freebusy"], "risk": "sensitive", "default": false, "usedBy": ["Calendar availability queries"]},
    "tasks": {"scopes": ["https://www.googleapis.com/auth/tasks"], "risk": "sensitive", "default": false, "usedBy": ["Google Tasks read/write operations"]},
    "docs": {"scopes": ["https://www.googleapis.com/auth/documents"], "risk": "sensitive", "default": false, "usedBy": ["Google Docs create/read/edit operations"]},
    "drive.read": {"scopes": ["https://www.googleapis.com/auth/drive.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Drive search/read operations"]},
    "drive.file": {"scopes": ["https://www.googleapis.com/auth/drive.file"], "risk": "non_sensitive_preferred", "default": false, "usedBy": ["Files created or opened by Elara"]},
    "sheets.read": {"scopes": ["https://www.googleapis.com/auth/spreadsheets.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Google Sheets read operations"]},
    "sheets.write": {"scopes": ["https://www.googleapis.com/auth/spreadsheets"], "risk": "sensitive", "default": false, "usedBy": ["Google Sheets write operations"]},
    "contacts.read": {"scopes": ["https://www.googleapis.com/auth/contacts.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Google Contacts read operations"]},
    "chat.read": {"scopes": ["https://www.googleapis.com/auth/chat.spaces.readonly", "https://www.googleapis.com/auth/chat.messages.readonly", "https://www.googleapis.com/auth/chat.memberships.readonly"], "risk": "sensitive", "default": false, "usedBy": ["Google Chat space/message/member read operations"]},
    "chat.send": {"scopes": ["https://www.googleapis.com/auth/chat.messages.create"], "risk": "sensitive", "default": false, "usedBy": ["Google Chat message creation"]},
    "chat.manage": {"scopes": ["https://www.googleapis.com/auth/chat.spaces", "https://www.googleapis.com/auth/chat.spaces.create", "https://www.googleapis.com/auth/chat.messages", "https://www.googleapis.com/auth/chat.memberships"], "risk": "sensitive_restricted", "default": false, "requiresExplicitEscalation": true, "usedBy": ["Google Chat space/message/member management when required"]}
  },
  "initialRequestMustNotContain": [
    "https://www.googleapis.com/auth/gmail.send",
    "https://www.googleapis.com/auth/gmail.compose",
    "https://www.googleapis.com/auth/gmail.modify",
    "https://www.googleapis.com/auth/calendar",
    "https://www.googleapis.com/auth/tasks",
    "https://www.googleapis.com/auth/documents",
    "https://www.googleapis.com/auth/drive.readonly",
    "https://www.googleapis.com/auth/drive.file",
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/contacts.readonly",
    "https://www.googleapis.com/auth/chat.spaces",
    "https://www.googleapis.com/auth/chat.spaces.readonly",
    "https://www.googleapis.com/auth/chat.spaces.create",
    "https://www.googleapis.com/auth/chat.messages",
    "https://www.googleapis.com/auth/chat.messages.readonly",
    "https://www.googleapis.com/auth/chat.messages.create",
    "https://www.googleapis.com/auth/chat.memberships.readonly",
    "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
    "https://www.googleapis.com/auth/calendar.freebusy"
  ]
}
