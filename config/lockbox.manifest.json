{
  "$schemaVersion": 1,
  "name": "elara-lockbox",
  "pass": 7,
  "purpose": "Authoritative inventory of runtime configuration, secrets, and credential boundaries. Values are never stored here.",
  "entries": [
    { "name": "GEMINI_API_KEY", "class": "CRITICAL_SECRET", "scope": ["server", "background-worker", "automation-ci"], "exposure": ["server", "worker", "ci"], "lifecycle": { "owner": "platform", "rotationMode": "manual", "recommendedDays": 90, "expiryRequired": true, "notes": "Rotate through the provider and update every consuming runtime before re-enabling traffic." } },
    { "name": "GEMINI_MODEL", "class": "PUBLIC_CONFIG", "scope": ["server", "background-worker", "automation-ci"], "exposure": ["server", "worker", "ci"] },
    { "name": "NODE_ENV", "class": "RUNTIME_CONFIG", "scope": ["server"], "exposure": ["server"] },
    { "name": "APP_URL", "class": "PUBLIC_CONFIG", "scope": ["app", "server"], "exposure": ["server"] },
    { "name": "VITE_GOOGLE_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["browser"], "exposure": ["browser"] },
    { "name": "GOOGLE_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["browser-compatibility"], "exposure": ["browser"] },
    { "name": "GOOGLE_OAUTH_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["cloudflare-google-auth-worker"], "exposure": ["worker", "ci"] },
    { "name": "GOOGLE_OAUTH_CLIENT_SECRET", "class": "CRITICAL_SECRET", "scope": ["cloudflare-google-auth-worker"], "exposure": ["worker", "ci"], "lifecycle": { "owner": "platform", "rotationMode": "manual", "recommendedDays": 180, "expiryRequired": true, "notes": "Rotate the OAuth client secret and update the Worker/CI secret together." } },
    { "name": "GOOGLE_OAUTH_REDIRECT_URI", "class": "PUBLIC_CONFIG", "scope": ["cloudflare-google-auth-worker"], "exposure": ["worker", "ci"] },
    { "name": "GOOGLE_VAULT_KV", "class": "PRIVATE_BINDING", "scope": ["cloudflare-background-worker"], "exposure": ["worker"], "lifecycle": { "owner": "platform", "rotationMode": "runtime-managed", "expiryRequired": false, "notes": "Cloudflare-managed binding; rotate underlying infrastructure credentials through the platform rather than the app." } },
    { "name": "GOOGLE_VAULT_KV_NAMESPACE_ID", "class": "INFRA_SECRET", "scope": ["deployment-ci"], "exposure": ["ci"], "lifecycle": { "owner": "platform", "rotationMode": "manual", "expiryRequired": false, "notes": "Infrastructure identifier; replace only when the KV namespace changes." } },
    { "name": "ELARA_SERVER_ACCESS_TOKEN", "class": "CRITICAL_SECRET", "scope": ["authenticated-production-express-api"], "exposure": ["server", "ci"], "lifecycle": { "owner": "platform", "rotationMode": "manual", "recommendedDays": 90, "expiryRequired": true, "notes": "Do not embed in browser bundles; rotate before enabling public backend callers." } },
    { "name": "ELARA_ALLOWED_ORIGINS", "class": "PRIVATE_CONFIG", "scope": ["production-express-cors"], "exposure": ["server", "ci"] },
    { "name": "CLOUDFLARE_API_TOKEN", "class": "CRITICAL_SECRET", "scope": ["deployment-ci"], "exposure": ["ci"], "lifecycle": { "owner": "platform", "rotationMode": "manual", "recommendedDays": 90, "expiryRequired": true, "notes": "Use the narrowest deploy-only token scope supported by the Cloudflare account." } },
    { "name": "CLOUDFLARE_ACCOUNT_ID", "class": "INFRA_CONFIG", "scope": ["deployment-ci"], "exposure": ["ci"], "lifecycle": { "owner": "platform", "rotationMode": "not-applicable", "expiryRequired": false, "notes": "Stable account identifier." } },
    { "name": "ELARA_BACKGROUND_TOKEN", "class": "CRITICAL_SECRET", "scope": ["cloudflare-background-worker", "deployment-ci"], "exposure": ["worker", "ci"], "lifecycle": { "owner": "platform", "rotationMode": "manual", "recommendedDays": 90, "expiryRequired": true, "notes": "Rotate Worker authorization token and redeploy before invalidating the old value." } },
    { "name": "ELARA_STATE_REPO", "class": "PRIVATE_CONFIG", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "ELARA_STATE_TOKEN", "class": "CRITICAL_SECRET", "scope": ["automation-ci"], "exposure": ["ci"], "lifecycle": { "owner": "automation", "rotationMode": "manual", "recommendedDays": 90, "expiryRequired": true, "notes": "Use a dedicated least-privilege GitHub token for the private state repository." } },
    { "name": "ELARA_GOOGLE_TOKEN", "class": "CRITICAL_SECRET", "scope": ["automation-ci"], "exposure": ["ci"], "lifecycle": { "owner": "automation", "rotationMode": "automatable", "recommendedDays": 30, "expiryRequired": true, "notes": "Prefer short-lived OAuth-derived credentials or a refresh flow over long-lived static tokens." } },
    { "name": "AUTOMATION_ID", "class": "JOB_INPUT", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "EXECUTION_KEY", "class": "JOB_INPUT", "scope": ["automation-ci"], "exposure": ["ci"], "lifecycle": { "owner": "automation", "rotationMode": "runtime-managed", "expiryRequired": false, "notes": "Per-execution identifier; never treat it as a reusable credential." } },
    { "name": "GITHUB_REPOSITORY", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "GITHUB_SERVER_URL", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "GITHUB_RUN_ID", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": ["ci"], "lifecycle": { "owner": "automation", "rotationMode": "runtime-managed", "expiryRequired": false, "notes": "Ephemeral GitHub Actions run metadata." } },
    { "name": "ELARA_CHAT_WORKFLOW", "class": "PRIVATE_BINDING", "scope": ["cloudflare-background-worker"], "exposure": ["worker"], "lifecycle": { "owner": "platform", "rotationMode": "runtime-managed", "expiryRequired": false, "notes": "Cloudflare-managed workflow binding." } }
  ],
  "rules": {
    "neverCommitValues": true,
    "neverExposeSecretsToBrowser": true,
    "neverLogSecrets": true,
    "neverUseVitePrefixForSecrets": true,
    "automationCredentialsAreCritical": true,
    "aSecretMayHaveMultipleExplicitTrustExposures": true,
    "automationScriptsUseLockboxAdapter": true,
    "sourceMustNotBypassLockbox": true,
    "knownCredentialPatternsMustNotAppearInTrackedText": true,
    "diagnosticsMustNeverReturnSecretValues": true,
    "criticalSecretsRequireLifecyclePolicy": true
  }
}
