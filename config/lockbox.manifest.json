{
  "$schemaVersion": 1,
  "name": "elara-lockbox",
  "pass": 5,
  "purpose": "Authoritative inventory of runtime configuration, secrets, and credential boundaries. Values are never stored here.",
  "entries": [
    { "name": "GEMINI_API_KEY", "class": "CRITICAL_SECRET", "scope": ["server", "background-worker", "automation-ci"], "exposure": ["server", "worker", "ci"] },
    { "name": "GEMINI_MODEL", "class": "PUBLIC_CONFIG", "scope": ["server", "background-worker", "automation-ci"], "exposure": ["server", "worker", "ci"] },
    { "name": "NODE_ENV", "class": "RUNTIME_CONFIG", "scope": ["server"], "exposure": ["server"] },
    { "name": "APP_URL", "class": "PUBLIC_CONFIG", "scope": ["app", "server"], "exposure": ["server"] },
    { "name": "VITE_GOOGLE_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["browser"], "exposure": ["browser"] },
    { "name": "GOOGLE_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["browser-compatibility"], "exposure": ["browser"] },
    { "name": "GOOGLE_OAUTH_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["cloudflare-google-auth-worker"], "exposure": ["worker", "ci"] },
    { "name": "GOOGLE_OAUTH_CLIENT_SECRET", "class": "CRITICAL_SECRET", "scope": ["cloudflare-google-auth-worker"], "exposure": ["worker", "ci"] },
    { "name": "GOOGLE_OAUTH_REDIRECT_URI", "class": "PUBLIC_CONFIG", "scope": ["cloudflare-google-auth-worker"], "exposure": ["worker", "ci"] },
    { "name": "GOOGLE_VAULT_KV", "class": "PRIVATE_BINDING", "scope": ["cloudflare-background-worker"], "exposure": ["worker"] },
    { "name": "GOOGLE_VAULT_KV_NAMESPACE_ID", "class": "INFRA_SECRET", "scope": ["deployment-ci"], "exposure": ["ci"] },
    { "name": "CLOUDFLARE_API_TOKEN", "class": "CRITICAL_SECRET", "scope": ["deployment-ci"], "exposure": ["ci"] },
    { "name": "CLOUDFLARE_ACCOUNT_ID", "class": "INFRA_CONFIG", "scope": ["deployment-ci"], "exposure": ["ci"] },
    { "name": "ELARA_BACKGROUND_TOKEN", "class": "CRITICAL_SECRET", "scope": ["cloudflare-background-worker", "deployment-ci"], "exposure": ["worker", "ci"] },
    { "name": "ELARA_STATE_REPO", "class": "PRIVATE_CONFIG", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "ELARA_STATE_TOKEN", "class": "CRITICAL_SECRET", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "ELARA_GOOGLE_TOKEN", "class": "CRITICAL_SECRET", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "AUTOMATION_ID", "class": "JOB_INPUT", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "EXECUTION_KEY", "class": "JOB_INPUT", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "GITHUB_REPOSITORY", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "GITHUB_SERVER_URL", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "GITHUB_RUN_ID", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": ["ci"] },
    { "name": "ELARA_CHAT_WORKFLOW", "class": "PRIVATE_BINDING", "scope": ["cloudflare-background-worker"], "exposure": ["worker"] }
  ],
  "rules": {
    "neverCommitValues": true,
    "neverExposeSecretsToBrowser": true,
    "neverLogSecrets": true,
    "neverUseVitePrefixForSecrets": true,
    "automationCredentialsAreCritical": true,
    "aSecretMayHaveMultipleExplicitTrustExposures": true,
    "automationScriptsUseLockboxAdapter": true,
    "sourceMustNotBypassLockbox": true,
    "knownCredentialPatternsMustNotAppearInTrackedText": true,
    "diagnosticsMustNeverReturnSecretValues": true
  }
}
