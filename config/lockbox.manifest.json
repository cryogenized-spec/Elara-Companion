{
  "$schemaVersion": 1,
  "name": "elara-lockbox",
  "pass": 1,
  "purpose": "Authoritative inventory of runtime configuration, secrets, and credential boundaries. Values are never stored here.",
  "entries": [
    { "name": "GEMINI_API_KEY", "class": "CRITICAL_SECRET", "scope": ["server", "automation-ci"], "exposure": "server-only" },
    { "name": "GEMINI_MODEL", "class": "PUBLIC_CONFIG", "scope": ["server", "automation-ci"], "exposure": "non-secret" },
    { "name": "NODE_ENV", "class": "RUNTIME_CONFIG", "scope": ["server"], "exposure": "non-secret" },
    { "name": "APP_URL", "class": "PUBLIC_CONFIG", "scope": ["app", "server"], "exposure": "non-secret", "status": "declared; active usage requires validation" },
    { "name": "VITE_GOOGLE_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["browser"], "exposure": "public" },
    { "name": "GOOGLE_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["browser-compatibility"], "exposure": "public" },
    { "name": "GOOGLE_OAUTH_CLIENT_ID", "class": "PUBLIC_CONFIG", "scope": ["cloudflare-google-auth-worker"], "exposure": "worker" },
    { "name": "GOOGLE_OAUTH_CLIENT_SECRET", "class": "CRITICAL_SECRET", "scope": ["cloudflare-google-auth-worker"], "exposure": "worker-only" },
    { "name": "GOOGLE_OAUTH_REDIRECT_URI", "class": "PUBLIC_CONFIG", "scope": ["cloudflare-google-auth-worker"], "exposure": "non-secret" },
    { "name": "GOOGLE_VAULT_KV", "class": "PRIVATE_BINDING", "scope": ["cloudflare-background-worker"], "exposure": "worker-only" },
    { "name": "GOOGLE_VAULT_KV_NAMESPACE_ID", "class": "INFRA_SECRET", "scope": ["deployment-ci"], "exposure": "ci-only" },
    { "name": "CLOUDFLARE_API_TOKEN", "class": "CRITICAL_SECRET", "scope": ["deployment-ci"], "exposure": "ci-only" },
    { "name": "CLOUDFLARE_ACCOUNT_ID", "class": "INFRA_CONFIG", "scope": ["deployment-ci"], "exposure": "ci-only" },
    { "name": "ELARA_STATE_REPO", "class": "PRIVATE_CONFIG", "scope": ["automation-ci"], "exposure": "ci-only" },
    { "name": "ELARA_STATE_TOKEN", "class": "CRITICAL_SECRET", "scope": ["automation-ci"], "exposure": "ci-only" },
    { "name": "ELARA_GOOGLE_TOKEN", "class": "CRITICAL_SECRET", "scope": ["automation-ci"], "exposure": "ci-only" },
    { "name": "AUTOMATION_ID", "class": "JOB_INPUT", "scope": ["automation-ci"], "exposure": "ci-only" },
    { "name": "EXECUTION_KEY", "class": "JOB_INPUT", "scope": ["automation-ci"], "exposure": "ci-only" },
    { "name": "GITHUB_REPOSITORY", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": "ci-provided" },
    { "name": "GITHUB_SERVER_URL", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": "ci-provided" },
    { "name": "GITHUB_RUN_ID", "class": "RUNTIME_METADATA", "scope": ["automation-ci"], "exposure": "ci-provided" },
    { "name": "ELARA_CHAT_WORKFLOW", "class": "PRIVATE_BINDING", "scope": ["cloudflare-background-worker"], "exposure": "worker-only" }
  ],
  "rules": {
    "neverCommitValues": true,
    "neverExposeSecretsToBrowser": true,
    "neverLogSecrets": true,
    "neverUseVitePrefixForSecrets": true,
    "automationCredentialsAreCritical": true
  }
}
